# ---------------------------------------------------------------------------
# TEMPLATE ONLY — placeholders, never real credentials.
#
# This file IS committed. Your real .env is NOT: .gitignore ignores `.env` and
# `.env.*` while explicitly re-including this example.
#
# To use it:
#   1. Copy this file to `.env` in the project root.
#   2. Replace every REPLACE_WITH_* placeholder with the passwords you set when
#      running scripts/01_create_role_and_database.sql and
#      scripts/03_create_runtime_roles.sql.
#   3. Never commit `.env`. Never paste a password into a tracked file,
#      a commit message, or an issue.
#
# Precedence: a real environment variable always wins over a value in `.env`,
# so CI and production supply these as environment variables and ship no file.
# ---------------------------------------------------------------------------

# Deployment environment: dev | test | staging | prod
# Development-only adapters refuse to start unless this is `dev`.
ADW_APP_ENV=dev

# Log level: DEBUG | INFO | WARNING | ERROR
ADW_LOG_LEVEL=INFO

# --- Runtime connection ----------------------------------------------------
# adw_app: not a superuser, not a table owner, no BYPASSRLS. Every one of those
# exemptions would silently void row-level security, so the role holding none of
# them is what makes the policies real (D18/G3).
ADW_DATABASE_URL=postgresql+psycopg://adw_app:REPLACE_WITH_APP_PASSWORD@localhost:5432/adw_dev

# --- Migration connection --------------------------------------------------
# adw_owner: holds DDL, used by Alembic only. RLS policies, grants, and schema
# are Alembic's job; the application must not be able to change them.
ADW_MIGRATION_DATABASE_URL=postgresql+psycopg://adw_owner:REPLACE_WITH_OWNER_PASSWORD@localhost:5432/adw_dev

# --- LLM provider: Ollama Cloud (D8) ----------------------------------------
# All three are OPTIONAL. Leave them unset and the platform still starts, and
# the entire test suite still passes — tests run on the deterministic fake
# provider, never on a network call.
#
# Cloud models only. Nothing is pulled or run on this machine, so a large model
# costs no local RAM.

# API root. Change only to point at a proxy or a test double.
ADW_OLLAMA_BASE_URL=https://ollama.com

# Which cloud model to use. NO DEFAULT, on purpose: pinning a model in code
# would turn a vendor catalogue change into a code change. Pick one from
# https://ollama.com/search?c=cloud — e.g. gpt-oss:120b.
ADW_OLLAMA_MODEL=REPLACE_WITH_CLOUD_MODEL_NAME

# Create at https://ollama.com/settings/keys. This is a SecretStr: it never
# appears in a repr, a log line, an action record, or an audit entry. Put the
# real value in `.env` only — `.env` is gitignored and must stay that way.
ADW_OLLAMA_API_KEY=REPLACE_WITH_OLLAMA_API_KEY

# Per-request time budget, in seconds.
ADW_OLLAMA_TIMEOUT_SECONDS=60

# --- Nothing else belongs in this file --------------------------------------
# Settings uses extra="forbid", which rejects ANY key in the .env file that is
# not one of the settings above — the prefix is irrelevant. An extra key here
# does not get ignored; it stops the application from starting.
#
# Test-harness connections therefore live in `.env.test`. See `.env.test.example`.
