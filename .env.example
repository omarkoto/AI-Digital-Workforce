# ---------------------------------------------------------------------------
# TEMPLATE ONLY — placeholders, never real credentials.
#
# This file IS committed. Your real .env is NOT: .gitignore ignores `.env` and
# `.env.*` while explicitly re-including this example.
#
# To use it:
#   1. Copy this file to `.env` in the project root.
#   2. Replace REPLACE_WITH_LOCAL_PASSWORD with the adw_owner password you set
#      in pgAdmin (scripts/01_create_role_and_database.sql, step 1c).
#   3. Never commit `.env`. Never paste the password into a tracked file,
#      a commit message, or an issue.
#
# Precedence: a real environment variable always wins over a value in `.env`,
# so CI and production supply these as environment variables and ship no file.
# ---------------------------------------------------------------------------

# Deployment environment: dev | test | staging | prod
# Development-only adapters refuse to start unless this is `dev`.
ADW_APP_ENV=dev

# Log level: DEBUG | INFO | WARNING | ERROR
ADW_LOG_LEVEL=INFO

# Database URL for the dedicated project database.
# The `postgresql+psycopg` driver is required and validated at startup.
# Task 1 connects as adw_owner. Task 3 introduces adw_app — a non-owner without
# BYPASSRLS — and the runtime connection switches to it, per D18/G3.
ADW_DATABASE_URL=postgresql+psycopg://adw_owner:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/adw_dev

# Optional. Enables the integration tests, which are skipped when unset.
# Point this at a disposable database, never at adw_dev with real data.
# ADW_TEST_DATABASE_URL=postgresql+psycopg://adw_owner:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/adw_dev
