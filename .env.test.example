# ---------------------------------------------------------------------------
# TEMPLATE ONLY — placeholders, never real credentials.
#
# Copy to `.env.test` and fill in. `.env.test` is gitignored.
#
# Why a separate file: `Settings` uses extra="forbid", which rejects any key in
# `.env` that is not a declared setting. Test-harness variables would therefore
# stop the application from starting if they lived there. Keeping them here
# keeps `.env` valid and this file free to hold whatever the suite needs.
#
# pytest loads both files into the environment at session start. Existing
# environment variables always win, so CI supplies these directly and ships no
# file.
#
# Every variable here is optional: the suites that need them skip cleanly when
# they are unset.
# ---------------------------------------------------------------------------

# Integration tests — a database the suite may read. Task 3 points this at the
# owner connection; once migrations create schema, point it at a dedicated
# throwaway database rather than one holding real data.
PYTEST_DATABASE_URL=postgresql+psycopg://adw_owner:REPLACE_WITH_OWNER_PASSWORD@localhost:5432/adw_dev

# Tenant-isolation suite — proves each role's limits.
# adw_anchor may read chain-head hashes only (I13); the suite asserts it cannot
# read tenant tables.
PYTEST_ANCHOR_DATABASE_URL=postgresql+psycopg://adw_anchor:REPLACE_WITH_ANCHOR_PASSWORD@localhost:5432/adw_dev
PYTEST_AUDITOR_DATABASE_URL=postgresql+psycopg://adw_auditor:REPLACE_WITH_AUDITOR_PASSWORD@localhost:5432/adw_dev
